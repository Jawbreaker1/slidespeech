LLM_PROVIDER=lmstudio
ILLUSTRATION_PROVIDER=mock
VISION_PROVIDER=mock
STT_PROVIDER=mock
TTS_PROVIDER=mock
VAD_PROVIDER=mock
WEB_RESEARCH_PROVIDER=hosted
STORAGE_PROVIDER=file
FASTER_WHISPER_PYTHON_BIN=.venv-stt/bin/python
FASTER_WHISPER_MODEL=base
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_BEAM_SIZE=3
FASTER_WHISPER_LANGUAGE=auto
PIPER_TTS_PYTHON_BIN=.venv-tts/bin/python
PIPER_TTS_MODEL_PATH=models/tts/en_US-hfc_male-medium.onnx
PIPER_TTS_CONFIG_PATH=models/tts/en_US-hfc_male-medium.onnx.json
PIPER_TTS_SENTENCE_SILENCE_MS=80
API_PORT=4000
API_HOST=127.0.0.1
WEB_PORT=3000
# Browser requests use /api on the web origin. Optional server-side proxy target:
# SLIDESPEECH_API_ORIGIN=http://127.0.0.1:4000
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=local-model
LMSTUDIO_VISION_MODEL=local-vision-model
LMSTUDIO_API_KEY=
LLM_TIMEOUT_MS=45000
LLM_FALLBACK_TO_MOCK_ON_ERROR=false
WEB_RESEARCH_TIMEOUT_MS=15000
VOICE_MAX_AUDIO_BYTES=5000000
